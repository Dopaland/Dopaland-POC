#!/usr/bin/env bash
# Pre-commit guard, configured via `git config core.hooksPath .githooks`.
#
# Blocks a commit if any STAGED file is media -- detected by BOTH file
# extension AND magic-byte content sniffing (an extension check alone is
# trivially wrong) -- or contains a secret-like pattern (an Anthropic API
# key, or a KEY/TOKEN/SECRET/PASSWORD/CREDENTIAL-named variable assigned a
# high-entropy value).
#
# CLAUDE.md guardrail G4: raw participant media and secrets must never enter
# git history. History is permanent -- this hook is the last line of defense
# before that becomes irreversible. A guard that has never been observed to
# fire is not a guard; this one is exercised deliberately in Step 3.2 before
# it is trusted.
#
# Checks the STAGED content (`git show :<path>`), not the working-tree copy
# -- what is actually about to be committed, not whatever is currently on
# disk, in case the two differ.
set -euo pipefail

python3 - <<'PYEOF'
import re
import subprocess
import sys

MEDIA_EXTENSIONS = {
    ".mp4", ".avi", ".mov", ".mkv", ".webm", ".wmv", ".flv", ".m4v", ".mpg", ".mpeg",
    ".wav", ".mp3", ".m4a", ".aac", ".ogg", ".flac",
    # Audio additions (D0PA1 audio acquisition task): every extension named
    # explicitly by that task's own list, plus every other container capable
    # of carrying an audio track this hook did not already recognise via
    # ftyp (.3gp/.3g2 share MP4's ftyp box) or EBML (.mka shares MKV/WEBM's
    # EBML header) -- those two are covered by magic bytes already and are
    # listed here anyway, belt-and-suspenders, so the extension check alone
    # (cheaper, runs first) also catches them without needing content sniffed.
    ".opus", ".wma", ".aiff", ".aif", ".au", ".caf", ".amr", ".mka", ".3gp", ".3g2",
    ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".tiff", ".tif", ".heic", ".webp", ".raw",
}

MAGIC_SIGNATURES = [
    (b"\xff\xd8\xff", "JPEG"),
    (b"\x89PNG\r\n\x1a\n", "PNG"),
    (b"GIF87a", "GIF"),
    (b"GIF89a", "GIF"),
    (b"BM", "BMP"),
    (b"RIFF", "RIFF container (WAV/AVI)"),
    (b"ftyp", "MP4/MOV/3GP (ftyp box, offset-scanned)"),
    (b"\x1aE\xdf\xa3", "MKV/WEBM/MKA (EBML)"),
    (b"ID3", "MP3 (ID3 tag)"),
    (b"OggS", "OGG/Opus"),
    (b"fLaC", "FLAC"),
    # Audio additions (D0PA1 audio acquisition task) -- same "content, not
    # just extension" discipline as the signatures above, so a wrong or
    # missing extension on any of these containers still gets caught.
    (b"\x30\x26\xb2\x75\x8e\x66\xcf\x11", "WMA/ASF (header GUID)"),
    (b"AIFF", "AIFF (form type, inside a FORM chunk)"),
    (b"AIFC", "AIFF-C (form type, inside a FORM chunk)"),
    (b".snd", "AU/SND (Sun/NeXT audio)"),
    (b"caff", "CAF (Core Audio Format)"),
    (b"#!AMR", "AMR (adaptive multi-rate audio)"),
]

SECRET_PATTERNS = [
    re.compile(rb"sk-ant-[A-Za-z0-9_\-]{8,}"),
    re.compile(rb"(?i)\w*(KEY|TOKEN|SECRET|PASSWORD|CREDENTIAL)\w*\s*[:=]\s*['\"][A-Za-z0-9_\-]{12,}['\"]"),
]

# Legitimate placeholder occurrences (instructional text showing a user what
# to type) must not trip the guard -- a real key never contains these markers
# immediately after the prefix.
PLACEHOLDER_MARKERS = (b"sk-ant-...", b"sk-ant-<", b"sk-ant-XXXX", b"sk-ant-your")


def staged_files():
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True, text=True, check=True,
    )
    return [f for f in out.stdout.splitlines() if f.strip()]


def staged_content(path):
    result = subprocess.run(["git", "show", f":{path}"], capture_output=True, check=True)
    return result.stdout


def check_media(path, content):
    ext = ("." + path.rsplit(".", 1)[-1].lower()) if "." in path else ""
    if ext in MEDIA_EXTENSIONS:
        return f"media file extension ({ext})"
    head = content[:64]
    for sig, kind in MAGIC_SIGNATURES:
        if head.startswith(sig) or sig in head[:32]:
            return f"media magic bytes detected ({kind})"
    return None


def check_secret(path, content):
    for pattern in SECRET_PATTERNS:
        for m in pattern.finditer(content):
            snippet = content[max(0, m.start() - 4): m.end() + 4]
            if any(marker in snippet for marker in PLACEHOLDER_MARKERS):
                continue
            line_no = content[: m.start()].count(b"\n") + 1
            return f"secret-like pattern at line {line_no}"
    return None


def main():
    blocked = []
    for path in staged_files():
        try:
            content = staged_content(path)
        except subprocess.CalledProcessError:
            continue  # staged deletion, submodule, etc -- nothing to scan
        reason = check_media(path, content)
        if reason is None:
            reason = check_secret(path, content)
        if reason:
            blocked.append((path, reason))

    if blocked:
        sys.stderr.write("!" * 70 + "\n")
        sys.stderr.write("COMMIT BLOCKED by .githooks/pre-commit\n")
        for path, reason in blocked:
            sys.stderr.write(f"  {path}: {reason}\n")
        sys.stderr.write("!" * 70 + "\n")
        sys.stderr.write("Raw media and secrets must never enter git history (CLAUDE.md G4).\n")
        sys.stderr.write("If this is a false positive, fix the detection logic -- do not bypass with --no-verify.\n")
        return 1
    return 0


sys.exit(main())
PYEOF
